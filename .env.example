# Active local credentials file: server/data/credentials.env
# You may copy this template there. Never commit that file or paste real secrets into source control.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_SIGNING_SECRET=
SLACK_WEBHOOK_URL=
OPENAI_API_KEY=
OPENAI_API_KEY_1=
OPENAI_API_KEY_2=
OPENAI_API_KEY_3=
OPENAI_API_KEY_4=
OPENAI_CHAT_MODEL=gpt-5
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_API_KEY_1=
OPENCODE_ZEN_API_KEY_2=
OPENCODE_ZEN_API_KEY_3=
OPENCODE_ZEN_API_KEY_4=
NINEROUTER_API_KEY=
NINEROUTER_API_KEY_1=
NINEROUTER_API_KEY_2=
NINEROUTER_API_KEY_3=
NINEROUTER_API_KEY_4=
CUSTOM_API_KEY=
CUSTOM_API_KEY_1=
CUSTOM_API_KEY_2=
CUSTOM_API_KEY_3=
CUSTOM_API_KEY_4=
SEARCH_PROVIDER_URL=
SEARCH_PROVIDER_KEY=
CALENDAR_API_URL=
MESSAGING_API_URL=
MESSAGING_TOKEN=
HARDWARE_ENDPOINT=
HARDWARE_TOKEN=
JARVIS_AUTH_TOKEN=
# Phone companion is disabled until all three are set. Use a 32+ character random master key.
JARVIS_HOST=127.0.0.1
JARVIS_PHONE_BRIDGE_ALLOW_LAN=0
PHONE_BRIDGE_MASTER_KEY=
VOICE_STT_URL=
VOICE_TTS_URL=
TTS_PROVIDER=browser
GROQ_API_KEY=
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GEMINI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_CHAT_MODEL=gemini-2.5-pro
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_VIDEO_MODEL=veo-3.1-generate-preview
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=autumn
PROVIDER_FALLBACK_ORDER=groq,openrouter,opencode-zen,9router
# Managed automatically by Settings when individual credential slots are disabled.
JARVIS_DISABLED_CREDENTIALS=
JARVIS_ROUTER_DEBUG=false
# Official Cactus Needle 2 local reflex/tool router.
JARVIS_NEEDLE_ENABLED=true
# Optional override. Leave empty to use .venv-needle/Scripts/python.exe on Windows
# or .venv-needle/bin/python on Linux.
JARVIS_NEEDLE_PYTHON=
JARVIS_NEEDLE_AUTO_EXEC_THRESHOLD=0.90
JARVIS_NEEDLE_READ_ONLY_THRESHOLD=0.85
JARVIS_NEEDLE_FALLBACK_THRESHOLD=0.75
JARVIS_NEEDLE_TIMEOUT_MS=8000
JARVIS_NEEDLE_LOAD_TIMEOUT_MS=120000
JARVIS_NEEDLE_TOOL_TOP_K=12
JARVIS_NEEDLE_MAX_TOKENS=256
# Experimental consumer-web adapter. Authentication is manual and the private profile is gitignored.
JARVIS_CHATGPT_WEB_ENABLED=false
JARVIS_CHATGPT_HEADLESS=true
JARVIS_CHATGPT_DEBUG=false
JARVIS_CHATGPT_PROFILE_DIR=
JARVIS_CHATGPT_TIMEOUT_MS=120000
JARVIS_CHATGPT_MAX_TOOL_STEPS=4
JARVIS_CHATGPT_MAX_CALLS_PER_STEP=4
JARVIS_CHATGPT_MAX_SESSION_TURNS=40
# Every browser-side inference conversation is created inside this exact ChatGPT Project.
JARVIS_CHATGPT_PROJECT_NAME=jarvis-chat
# Optional stable project URL discovered from ChatGPT. JARVIS validates the origin and project path before reuse.
JARVIS_CHATGPT_PROJECT_URL=
JARVIS_CHATGPT_URL=https://chatgpt.com/g/g-p-6a9ed38ea1c8819182eb991a96e4fc1c-jarvis-chat/c/6aa171a5-72fc-83e8-ac5f-1a3b70424a6a
# Gemini consumer-web adapter. Uses a separate persistent browser profile.
JARVIS_GEMINI_WEB_ENABLED=false
JARVIS_GEMINI_HEADLESS=true
JARVIS_GEMINI_PROFILE_DIR=
JARVIS_GEMINI_TIMEOUT_MS=120000
JARVIS_GEMINI_MAX_CALLS_PER_STEP=4
JARVIS_GEMINI_MAX_SESSION_TURNS=40
# Bounded model context and scalable tool-schema selection.
TOOL_FILTER_ENABLED=true
TOOL_FILTER_TOP_K=12
CONTEXT_MAX_CHARS=6000
CONTEXT_RECENT_TURNS=2
CONTEXT_TURN_CHAR_LIMIT=300
CONTEXT_MEMORY_TOP_K=5
CONTEXT_MEMORY_MIN_SCORE=0.2
# Absolute path to an existing Obsidian vault. The live Brain never creates demo nodes.
OBSIDIAN_VAULT_PATH=
# Optional Windows/headless communication bridge. The bridge must confirm call
# and message actions; JARVIS never infers success from a click attempt.
VOICE_OS_CONTROL_URL=
VOICE_OS_CONTROL_TOKEN=
VOICE_OS_BRIDGE_TOKEN=
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=jarvis-local-user
# Map toolkit slugs to Auth Config IDs created in the Composio dashboard.
COMPOSIO_AUTH_CONFIGS={"gmail":"ac_your_gmail_config","googlecalendar":"ac_your_calendar_config","discord":"ac_your_discord_config","discordbot":"ac_your_discord_bot_config","instagram":"ac_your_instagram_config"}
# Optional logical-model provider pools. Each credentialRef names a backend-only variable below.
# MODEL_PROVIDER_POOLS={"deepseek-v4-flash":[{"id":"deepseek-account-1","provider":"custom","baseUrl":"https://example.com/v1","modelId":"provider/model-id","credentialRef":"MODEL_API_KEY_1"}],"glm-5.2":[{"id":"glm-account-1","provider":"custom","baseUrl":"https://example.com/v1","modelId":"provider/model-id","credentialRef":"MODEL_API_KEY_2"}]}
