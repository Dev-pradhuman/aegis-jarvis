# Active local credentials file: server/data/credentials.env
# You may copy this template there. Never commit that file or paste real secrets into source control.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_SIGNING_SECRET=
SLACK_WEBHOOK_URL=
OPENROUTER_API_KEY=
# Automatic model and voice APIs only use models with verified zero pricing.
# Paid API usage requires BOTH settings below to be changed intentionally.
ZERO_SPEND_MODE=true
ALLOW_PAID_API_USAGE=false
AUTO_TOP_UP=false
AI_GATEWAY_API_KEY=
# Optional Brain provider keys. Leave empty until configured.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=
OPENCODE_API_KEY=
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_API_KEY_1=
OPENCODE_ZEN_API_KEY_2=
OPENCODE_ZEN_API_KEY_3=
OPENCODE_ZEN_API_KEY_4=
NINEROUTER_API_KEY=
NINEROUTER_API_KEY_1=
NINEROUTER_API_KEY_2=
NINEROUTER_API_KEY_3=
NINEROUTER_API_KEY_4=
CUSTOM_API_KEY=
CUSTOM_API_KEY_1=
CUSTOM_API_KEY_2=
CUSTOM_API_KEY_3=
CUSTOM_API_KEY_4=
SEARCH_PROVIDER_URL=
SEARCH_PROVIDER_KEY=
# Optional JSON array of local project roots or {"name":"...","root":"..."} objects.
JARVIS_PROJECT_ROOTS=[]
# Optional HTTP JSON-RPC MCP servers: [{"name":"office","url":"http://127.0.0.1:9000/mcp","tokenEnv":"OFFICE_MCP_TOKEN"}]
JARVIS_MCP_SERVERS=[]
# Set a private one-time pairing code before pairing a phone companion; never commit a real value.
JARVIS_DEVICE_PAIRING_CODE=
# Optional per-platform assistant attribution. Applied only when a send request has assistantAuthored=true.
# COMMUNICATION_SIGNATURES={"generic":"By JARVIS on behalf of Master Pradyuman","slack":"By JARVIS on behalf of Master Pradyuman"}
COMMUNICATION_SIGNATURES={}
CALENDAR_API_URL=
MESSAGING_API_URL=
MESSAGING_TOKEN=
HARDWARE_ENDPOINT=
HARDWARE_TOKEN=
JARVIS_AUTH_TOKEN=
# Opt in to consent-based desktop keyboard input. Requires JARVIS_AUTH_TOKEN and per-action approval.
JARVIS_DESKTOP_INPUT=0
VOICE_STT_URL=
VOICE_TTS_URL=
TTS_PROVIDER=browser
GROQ_API_KEY=
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GEMINI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_IMAGE_MODEL=
GEMINI_VIDEO_MODEL=
GROQ_CHAT_MODEL=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=autumn
# Legacy explicit paid-provider fallback only; AUTO uses local → authorized web → verified free API.
PROVIDER_FALLBACK_ORDER=
JARVIS_ROUTER_DEBUG=false
BROWSER_PRIMARY=lightpanda
BROWSER_MAX_RETRIES=1
BROWSER_IDLE_TIMEOUT_MS=120000
# Optional. Firefox profile defaults to ignored server/data/browser/firefox-profile.
BROWSER_FIREFOX_PROFILE=
# Bounded model context and scalable tool-schema selection.
TOOL_FILTER_ENABLED=true
TOOL_FILTER_TOP_K=12
CONTEXT_MAX_CHARS=6000
CONTEXT_RECENT_TURNS=2
CONTEXT_TURN_CHAR_LIMIT=300
CONTEXT_MEMORY_TOP_K=5
CONTEXT_MEMORY_MIN_SCORE=0.2
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=jarvis-local-user
# Map toolkit slugs to Auth Config IDs created in the Composio dashboard.
COMPOSIO_AUTH_CONFIGS={}
# Optional logical-model provider pools. Each credentialRef names a backend-only variable below.
# MODEL_PROVIDER_POOLS={"deepseek-v4-flash":[{"id":"deepseek-account-1","provider":"custom","baseUrl":"https://example.com/v1","modelId":"provider/model-id","credentialRef":"MODEL_API_KEY_1"}],"glm-5.2":[{"id":"glm-account-1","provider":"custom","baseUrl":"https://example.com/v1","modelId":"provider/model-id","credentialRef":"MODEL_API_KEY_2"}]}
MODEL_API_KEY_1=
MODEL_API_KEY_2=
MODEL_API_KEY_3=
MODEL_API_KEY_4=
MODEL_API_KEY_5=
MODEL_API_KEY_6=
